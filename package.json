{
  "name": "audiovis",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run check:licences",
    "check:licences": "node scripts/check-dist-licences.mjs",
    "licences:notices": "node scripts/gen-third-party-notices.mjs",
    "licences:check": "node scripts/gen-third-party-notices.mjs --check",
    "labels:list": "node scripts/mood-labels/label.mjs --list",
    "labels:gemini": "node scripts/mood-labels/label.mjs",
    "labels:compare": "node scripts/mood-labels/compare-to-jamendo.mjs",
    "labels:selftest": "node scripts/mood-labels/selftest.mjs",
    "labels:overnight": "node scripts/mood-labels/overnight.mjs",
    "labels:overnight-test": "node scripts/mood-labels/overnight-selftest.mjs",
    "build:commercial": "tsc -b && vite build && node scripts/check-dist-licences.mjs",
    "corpus:fetch": "node corpus/fetch.mjs",
    "calibrate:quantiles": "node --max-old-space-size=3072 ./node_modules/vitest/vitest.mjs run --config vitest.calibration.config.ts scripts/calibrate/emotion-quantiles.calib.ts",
    "eval:replay": "node ./node_modules/vitest/vitest.mjs run --config vitest.calibration.config.ts scripts/calibrate/emotion-replay.calib.ts",
    "calibrate:priors": "node ./node_modules/vitest/vitest.mjs run --config vitest.calibration.config.ts scripts/calibrate/character-priors.calib.ts",
    "eval:gemini": "node ./node_modules/vitest/vitest.mjs run --config vitest.calibration.config.ts scripts/calibrate/character-vs-gemini.calib.ts",
    "eval:emotion": "node --max-old-space-size=3072 ./node_modules/vitest/vitest.mjs run --config vitest.calibration.config.ts scripts/calibrate/emotion.calib.ts",
    "calibrate": "node --max-old-space-size=6144 ./node_modules/vitest/vitest.mjs run --config vitest.calibration.config.ts"
  },
  "dependencies": {
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.1",
    "@supabase/auth-ui-react": "^0.4.7",
    "@supabase/auth-ui-shared": "^0.1.8",
    "@supabase/supabase-js": "^2.45.4",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@tensorflow/tfjs-converter": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "essentia.js": "^0.1.3",
    "posthog-js": "^1.434.2",
    "postprocessing": "^6.37.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.18.2",
    "three": "^0.178.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.178.0",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "mpg123-decoder": "^1.0.3",
    "prettier": "^3.9.6",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0",
    "wrangler": "^4.121.0"
  }
}
