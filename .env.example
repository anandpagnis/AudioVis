# Copy to .env.local (gitignored) for local dev. Never commit real values.
#
# Bundled into the client — safe to expose, same as any SPA's public API keys
# (Supabase's own docs treat the anon/publishable key as public; access
# control happens server-side via RLS, not by hiding this).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# PostHog project API key — write-only (events in), can't read data back out,
# same public posture as the anon key above. From PostHog > Project settings.
VITE_POSTHOG_KEY=

# Essentia.js music-intelligence analysers (model tempo, musical key, song
# structure, voice/mood tags). OFF by default and must stay off in any build you
# distribute or sell: essentia.js is AGPL-3.0 and the MusiCNN weights in
# public/models are CC BY-NC-SA 4.0 (non-commercial). Local dev / internal
# builds only - uncomment in .env.local to turn them on. When off, the code and
# public/models are excluded from `vite build` output and
# `npm run check:licences` (scripts/check-dist-licences.mjs) fails the build if
# any of it leaks in. For an internal build made with this on, run the gate
# with `node scripts/check-dist-licences.mjs --allow-essentia`.
# VITE_ENABLE_ESSENTIA=1
