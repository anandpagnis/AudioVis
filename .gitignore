# Dependencies
node_modules/

# Build output
dist/
tsconfig.tsbuildinfo

# Test audio (MTG-Jamendo, CC BY-SA / BY-NC-SA).
# Deliberately local-only: committing would be redistribution, triggering
# attribution + share-alike obligations on this repo and dragging the dataset's
# non-commercial clause along with it. testfolder/tracks.json is committed and
# is enough to re-fetch the identical set — see testfolder/README.md.
testfolder/*.mp3
testfolder/*.wav
testfolder/*.flac

# Calibration corpus (MTG-Jamendo, ~1-2k tracks). Same redistribution reasoning
# as the test audio above. corpus/tracks.json (the id manifest) and the derived
# corpus/distributions.json + corpus/eval-report.md ARE committed — the audio,
# decoded frames and reference labels are not. See corpus/README.md.
corpus/audio/
corpus/frames/
corpus/refs/
corpus/emotion/

# Converted TF.js model weights (Essentia, CC BY-NC-SA). Binaries, and
# reproducible from scripts/convert-essentia-models.md — same reasoning as the
# test audio above.
public/models/

# TF.js WASM binaries, copied from node_modules by scripts/setup-tfjs-wasm.mjs
# so the voice worker never has to reach a CDN.
public/tfjs/

# Wrangler local cache/logs (Cloudflare deploy tooling)
.wrangler/
# Local secrets for `wrangler dev` (Stripe/Supabase keys) — *.local below
# already covers .env.local, but wrangler's own convention has no .local
# suffix, so it needs its own line.
.dev.vars

# Editor / OS
.idea/
.DS_Store
*.local

# Agent worktree checkouts — full copies of the repo, never redistributed.
.claude/worktrees/

# Gemini mood labels (scripts/mood-labels): derived from Jamendo audio + API output;
# regenerable, so kept local. Force-add deliberately if you want to commit a set.
corpus/labels/gemini/
corpus/labels/overnight.log
corpus/labels/.overnight.lock
